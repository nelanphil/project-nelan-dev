# Local development fallback values for `server/.env`.
# Any of these provided as Cloud Agent secrets / real environment variables take
# precedence at runtime: the server loads config via dotenv, which does NOT
# override variables already present in the environment. So injected secrets win
# and this file is only used to fill in whatever is not otherwise set.
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
MONGO_URI_DEVELOPMENT=mongodb://127.0.0.1:27017/nelan_dev
MONGO_URI_PRODUCTION=mongodb://127.0.0.1:27017/nelan_prod
JWT_SECRET=local-development-jwt-secret-change-me
